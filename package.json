{
  "name": "headless-codex",
  "version": "0.1.0",
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "latest"
  },
  "bin": {
    "headless-codex": "./src/cli.ts"
  },
  "private": true,
  "scripts": {
    "build": "bun build src/cli.ts --compile --outfile dist/headless-codex",
    "dev": "bun run src/cli.ts serve",
    "start": "bun run src/cli.ts serve",
    "check": "bunx tsc --noEmit",
    "help": "bun run src/cli.ts help"
  },
  "type": "module"
}
